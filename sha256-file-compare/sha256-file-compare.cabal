cabal-version:      3.0
name:               sha256-file-compare
version:            0.1.0.0
synopsis:           Compare sha256sum file lists
description:        Find duplicates, changed, removed, and new files.
license:            BSD-3-Clause
author:             Example
build-type:         Simple

common common-options
  default-language: Haskell2010
  ghc-options: -Wall

library
  import: common-options
  hs-source-dirs: src
  exposed-modules:
      Sha256FileCompare
  build-depends:
      base >= 4.14 && < 5,
      containers,
      filepath
  default-extensions:

executable compare-files
  import: common-options
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
      base >= 4.14 && < 5,
      sha256-file-compare
  default-extensions:

test-suite sha256-file-compare-tests
  import: common-options
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  build-depends:
      base >= 4.14 && < 5,
      HUnit,
      sha256-file-compare
  default-extensions:
